	"components": {
		"schemas": {
			"SaleRequest": {
				"type": "object",
				"properties": {
					"productId": {
						"type": "integer",
						"format": "int64"
					},
					"quantity": {
						"type": "integer",
						"format": "int32"
					}
				}
			},
			"SaleResponse": {
				"type": "object",
				"properties": {
					"saleId": {
						"type": "string"
					},
					"message": {
						"type": "string"
					}
				}
			},
			"PersonalDataRequest": {
				"type": "object",
				"properties": {
					"gender": {
						"type": "string",
						"enum": [
							"UOMO",
							"DONNA",
							"ALTRO",
							"NON_SPECIFICATO"
						]
					},
					"married": {
						"type": "boolean"
					},
					"birthdate": {
						"type": "string",
						"format": "date"
					},
					"elderlyParents": {
						"type": "boolean"
					},
					"children": {
						"type": "boolean"
					},
					"mobileNumber": {
						"pattern": "\\d+",
						"type": "string"
					},
					"sede": {
						"type": "string"
					},
					"reparto": {
						"type": "string"
					}
				}
			},
			"InteractionRequest": {
				"type": "object",
				"properties": {
					"productId": {
						"type": "integer",
						"format": "int64"
					},
					"interactionType": {
						"type": "string",
						"enum": [
							"CLICK",
							"VIEW",
							"SALE",
							"LIKE",
							"SHARE"
						]
					},
					"duration": {
						"type": "number",
						"format": "double"
					}
				}
			},
			"RegistrationRequest": {
				"required": [
					"email",
					"firstname",
					"lastname",
					"password"
				],
				"type": "object",
				"properties": {
					"firstname": {
						"type": "string"
					},
					"lastname": {
						"type": "string"
					},
					"email": {
						"type": "string"
					},
					"password": {
						"maxLength": 2147483647,
						"minLength": 8,
						"type": "string"
					}
				}
			},
			"AuthenticationRequest": {
				"required": [
					"email",
					"password"
				],
				"type": "object",
				"properties": {
					"email": {
						"type": "string"
					},
					"password": {
						"maxLength": 2147483647,
						"minLength": 8,
						"type": "string"
					}
				}
			},
			"AuthenticationResponse": {
				"type": "object",
				"properties": {
					"token": {
						"type": "string"
					}
				}
			},
			"UserResponse": {
				"type": "object",
				"properties": {
					"id": {
						"type": "integer",
						"format": "int32"
					},
					"email": {
						"type": "string"
					},
					"firsname": {
						"type": "string"
					},
					"lastname": {
						"type": "string"
					},
					"saved": {
						"type": "number",
						"format": "double"
					}
				}
			},
			"ProductResponse": {
				"type": "object",
				"properties": {
					"id": {
						"type": "integer",
						"format": "int64"
					},
					"name": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"price": {
						"type": "number",
						"format": "double"
					},
					"category": {
						"type": "string",
						"enum": [
							"ELETTRONICA",
							"FINANZE",
							"INVESTIMENTI",
							"ASSICURAZIONI",
							"IMMOBILIARE",
							"LAVORO",
							"ECOMMERCE",
							"SERVIZI",
							"STARTUP",
							"CONTABILITA",
							"VIAGGI",
							"SPORT",
							"FITNESS",
							"SALUTE",
							"BELLEZZA",
